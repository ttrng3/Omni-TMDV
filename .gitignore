# Never commit credentials. The weekly job writes through the GitHub MCP file
# tools with an injected credential and reads no token from this tree.
# The runbook is README.md — there is deliberately no second copy.
.github-token
.github-token.save
*.save
*.token

.DS_Store

# Build output. tools/build-fragment.py writes the artifact page here; it is
# derived from index.html on demand and is never the record.
build/
